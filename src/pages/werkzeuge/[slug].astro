---
import SiteLayout from '../../layouts/SiteLayout.astro';
import { tools } from '../../data/tools';
import OhmsLaw from '../../tools/ohmsches-gesetz/OhmsLaw';
import StackContainer from '../../tools/stack-container/StackContainer';
import Fractions from '../../tools/bruchteile/Fractions';

export function getStaticPaths() {
  return tools.map(tool => ({ params: { slug: tool.slug }, props: { tool } }));
}
const { tool } = Astro.props;
const base = import.meta.env.BASE_URL;
---
<SiteLayout title={tool.title} description={tool.description} wide>
  <div class="tool-page">
    <a class="back-link" href={base}>← Alle Werkzeuge</a>
    <div class="tool-intro">
      <div><p class="eyebrow">{tool.subject.toUpperCase()} · {tool.grades}</p><h1>{tool.title}</h1><p>{tool.description}</p></div>
      <span class="tool-format">{tool.badge}</span>
    </div>
    <section class="simulation-container" aria-label={`${tool.title} – Interaktive Anwendung`}>
      {tool.slug === 'ohmsches-gesetz' && <OhmsLaw client:load />}
      {tool.slug === 'stack-container' && <StackContainer client:load />}
      {tool.slug === 'bruchteile' && <Fractions client:load />}
    </section>
    <section class="teacher-info">
      <div><span class="info-label">LERNZIEL</span><h2>Das lernen wir</h2><p>{tool.learningGoal}</p></div>
      <div><span class="info-label">UNTERRICHTSIDEE</span><h2>Probiere es aus</h2><p>{tool.exampleActivity}</p></div>
    </section>
  </div>
</SiteLayout>
