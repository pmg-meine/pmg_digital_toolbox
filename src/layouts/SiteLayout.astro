---
import '../styles/global.css';
interface Props {
  title?: string;
  description?: string;
  wide?: boolean;
}
const { title = 'PMG Digital Toolbox', description = 'Interaktive Werkzeuge für den Unterricht am PMG.', wide = false } = Astro.props;
const base = import.meta.env.BASE_URL;
---
<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#431273" />
    <meta name="description" content={description} />
    <title>{title} · PMG Digital Toolbox</title>
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
  </head>
  <body>
    <a class="skip-link" href="#content">Zum Inhalt springen</a>
    <header class="site-header">
      <div class="header-inner">
        <a href={base} class="wordmark" aria-label="PMG Digital Toolbox – Startseite">
          <span class="wordmark-pmg">PMG<span class="plus" aria-hidden="true"><i></i><i></i><i></i><i></i></span></span>
          <span class="wordmark-label">DIGITAL<br/>TOOLBOX</span>
        </a>
        <nav aria-label="Hauptnavigation" class="nav-links">
          <a href={base}>Werkzeuge</a>
          <a href={`${base}ueber/`}>Über das Projekt</a>
          <a href="https://pmg-meine.de/" target="_blank" rel="noopener noreferrer">PMG Website <span aria-hidden="true">↗</span></a>
        </nav>
      </div>
    </header>
    <main id="content" class:list={['page-shell', { wide }]}>
      <slot />
    </main>
    <footer class="site-footer">
      <div class="footer-inner">
        <span><strong>PMG Digital Toolbox</strong> · Interaktive Werkzeuge für den Unterricht</span>
        <div><a href={`${base}ueber/`}>Projektinformationen</a><a href="https://pmg-meine.de/" target="_blank" rel="noopener noreferrer">Schulhomepage ↗</a></div>
      </div>
    </footer>
  </body>
</html>
